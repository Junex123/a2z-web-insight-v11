# Port the app server listens on.
PORT=3000

# Only set to true for local development/testing against localhost or
# private-network targets (e.g. the bundled mock-site). Leave unset (or
# false) in production - the collector blocks loopback/private-IP hosts
# by default, including redirect targets and DNS-rebound hostnames.
ALLOW_LOCAL_TARGETS=false

# --- PageSpeed Insights / Core Web Vitals ---

# Google PageSpeed Insights API key, used for real Core Web Vitals
# (LCP, INP, CLS, TTFB, FCP, Speed Index, Total Blocking Time) and the
# Lighthouse performance score. Get a free key at:
#   https://developers.google.com/speed/docs/insights/v5/get-started
# Optional: if unset, Core Web Vitals are simply reported as
# "not_configured" and the rest of the scan (Performance via our own
# HTTP measurements, SEO, Security) runs exactly as before.
# PAGESPEED_API_KEY is accepted as an alias if you prefer that name.
PAGESPEED_INSIGHTS_API_KEY=
# PAGESPEED_API_KEY=

# How long a successful PageSpeed result is cached, in seconds, keyed by
# normalized URL + strategy. Failed/unavailable results are never cached
# (see README - Caching). Default: 300s (5 minutes).
PAGESPEED_CACHE_TTL=300

# Per-attempt timeout for a PageSpeed Insights request, in milliseconds.
PAGESPEED_TIMEOUT=15000

# Max retry attempts for transient PageSpeed failures (network errors,
# 5xx responses). 429/other 4xx/malformed responses are never retried.
MAX_RETRIES=2

# --- Target website fetch ---

# Timeout for fetching the site being scanned, in milliseconds.
TARGET_FETCH_TIMEOUT=10000

# --- Rate limiting (POST /api/analyze) ---

# Max analyze requests allowed per client IP within the window below.
ANALYZE_RATE_LIMIT=30

# Rate limit window, in seconds.
ANALYZE_RATE_WINDOW=60
